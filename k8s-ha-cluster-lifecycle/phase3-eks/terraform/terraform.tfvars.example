# Copy to terraform.tfvars and adjust if needed. All values have defaults.

region             = "us-west-2"
cluster_name       = "k8s-ha-eks"
kubernetes_version = "1.34"   # check: aws eks describe-cluster-versions --region us-west-2
node_instance_type = "t3.medium"
node_desired_size  = 3

# api_allowed_cidrs = ["203.0.113.10/32"]   # empty = your current IP
