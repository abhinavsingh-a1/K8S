[control_plane]
%{ for n in control_planes ~}
${n.name} ansible_host=${n.public_ip} private_ip=${n.private_ip}
%{ endfor ~}

[workers]
%{ for n in workers ~}
${n.name} ansible_host=${n.public_ip} private_ip=${n.private_ip}
%{ endfor ~}

[k8s_cluster:children]
control_plane
workers

[all:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=${key_file}
api_endpoint=${api_endpoint}
ingress_node_port=${ingress_node_port}
